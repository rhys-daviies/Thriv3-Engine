ANTHROPIC_API_KEY=
API_PORT=8787

# Compliance. Required before any real outreach — sendOutreach refuses to run
# without the first two, and the trial preflight fails on them, because a
# commercial email without a sender identity and a valid physical postal
# address is unlawful whether it leaves through an ESP or through Outlook.
# Deliberately without defaults: a placeholder address satisfies the code
# while failing the law, and nothing downstream can tell the difference.
THRIV3_SENDER_IDENTITY=
THRIV3_POSTAL_ADDRESS=

# Where the opt-out link and privacy notice are served. Defaults to
# THRIV3_PUBLIC_BASE_URL, which is usually right.
THRIV3_UNSUBSCRIBE_BASE_URL=

# How often the edge sync runs by itself, in minutes. Unset or 0 means never,
# and the server says so at boot. The August 2026 failure — every tracked link
# in the wild dead for four days — was invisible precisely because nothing ran
# the sync unprompted. 15 is a sensible pilot cadence.
THRIV3_SYNC_INTERVAL_MINUTES=

# Per-inbox send cap: how many athletes may write to one coach, and over how
# many days. Protects the sending domain when several athletes' match lists
# converge on the same popular program. 0 disables it.
THRIV3_COACH_MAX_SENDS=3
THRIV3_COACH_WINDOW_DAYS=30

# ---------------------------------------------------------------------------
# OPERATOR ACCESS AND HOSTING — Phase 13K.
#
# NAMES ONLY. Never a value: this file is in git, and a secret with a default
# is a secret in every checkout of this repository. In production every one of
# these comes from the host's own secret storage, and startup refuses to run
# without the ones it cannot safely default (see docs/hosting.md).
# ---------------------------------------------------------------------------

# Signs nothing and encrypts nothing: it is the key the session token is
# hashed under before it is stored, so rotating this signs every operator out.
# Required in production, minimum 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
THRIV3_SESSION_SECRET=

# The operator app's own origin, e.g. https://app.example.com. It is the CORS
# allow-list and the CSRF origin check, so a wrong value refuses every
# state-changing request rather than allowing a wrong one. Required in
# production, and must be https.
THRIV3_APP_ORIGIN=

# Where the app listens. The default is 127.0.0.1 — deliberately unreachable
# from the network — so a hosted process has to say 0.0.0.0 out loud.
API_HOST=

# How many proxies sit in front of this process: 1 on a platform that
# terminates TLS for you, 0 if nothing does. Required in production, because
# too low means no Secure cookie and too high means trusting a forged
# X-Forwarded-For.
THRIV3_TRUST_PROXY=

# Both must be absolute paths on the persistent disk in production. The
# defaults live inside the source tree, which on a container host is discarded
# on the next deploy — and a generated report is a document that was sent.
RECRUITMATCH_DB=
THRIV3_REPORT_STORE=

# Where the built operator app is served from, when this process serves it
# (the hosted shape: one origin for the app and its API). Unset locally, where
# Vite serves it.
THRIV3_CLIENT_DIR=

# Optional. Session lifetimes in hours/days, and the scrypt work factor as
# log2(N). Defaults: 12, 7, 16.
THRIV3_SESSION_IDLE_HOURS=
THRIV3_SESSION_MAX_DAYS=
THRIV3_SCRYPT_COST=

# Read ONLY by server/scripts/createOperator.js, so the first operator's
# password never becomes a command-line argument in the shell history or in
# `ps`. Never set in a deployed environment: set it for the one command.
THRIV3_OPERATOR_PASSWORD=
