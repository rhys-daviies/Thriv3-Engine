{
  "name": "thriv3",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "archive-template": "node server/scripts/archiveEmailTemplate.js",
    "audit:performance": "node server/scripts/auditPerformanceSource.js",
    "backtest": "node server/scripts/backtestMatching.js",
    "backup": "node server/scripts/backup.js",
    "build": "vite build && npm run build:worker",
    "build:recruiting": "node server/scripts/buildRecruitingHistory.js",
    "build:worker": "esbuild worker/index.js --bundle --format=esm --platform=neutral --outfile=build/worker/_worker.js",
    "coaching-import": "node server/scripts/coachingImport.js",
    "confirm-sends": "node server/scripts/confirmSends.js",
    "dev": "concurrently -k -n server,client -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:client": "vite",
    "dev:server": "node server/index.js",
    "draft": "node server/scripts/draftOutreach.js",
    "edge:schema": "wrangler d1 execute thriv3-engagement --remote --file worker/schema.sql",
    "evidence": "node server/scripts/evidenceReport.js",
    "evidence:baseline": "node server/scripts/evidenceBaseline.js",
    "export:profiles": "node server/scripts/exportProfiles.js",
    "import-rosters": "node server/scripts/importRosterSheets.js",
    "import:seasons": "node server/scripts/importProgrammeSeasons.js",
    "migrate-composition": "node server/scripts/migrateCompositionAuthority.js",
    "migrate:templates": "node server/scripts/migrateEmailTemplates.js",
    "operator": "node server/scripts/createOperator.js",
    "outreach-qa": "node server/scripts/outreachQA.js",
    "panel-baseline": "vitest run src/components/panelBaseline.test.js --reporter=verbose",
    "project-minutes": "node server/scripts/projectRosterMinutes.js",
    "publish": "node server/scripts/publishSite.js",
    "recruiting:evidence": "node server/scripts/recruitingEvidenceReport.js",
    "recruiting:patterns": "node server/scripts/recruitingPatterns.js",
    "rollup": "node server/scripts/rebuildRollups.js",
    "roster-sources": "node server/scripts/rosterSourceAudit.js",
    "seed": "node server/seed/seedFromLocalData.js",
    "seed:activity": "node server/seed/seedEngagementActivity.js",
    "seed:engagement": "node server/seed/seedEngagement.js",
    "simulate": "node server/seed/simulateEngagement.js",
    "snapshot:pi": "node server/scripts/snapshotProgrammeIntelligence.js",
    "suppress": "node server/scripts/suppress.js",
    "sync": "node server/scripts/syncEngagement.js",
    "test": "vitest run",
    "test:acceptance": "vitest run server/export/tracker.test.js server/routes/publicProfile.test.js server/routes/track.test.js server/lib/athleteLifecycle.test.js server/lib/engagementRollup.test.js server/lib/publishPermanence.test.js worker/index.test.js",
    "test:baseline": "vitest run server/lib/evidenceBaseline.test.js --reporter=verbose",
    "test:generalisation": "node server/scripts/generalisationRun.js && vitest run shared/evidence/generalisation.test.js --reporter=verbose",
    "test:operations": "vitest run server/scripts/operations.test.js --reporter=verbose",
    "test:reports": "vitest run server/scripts/reports.test.js --reporter=verbose",
    "test:watch": "vitest",
    "trial:preflight": "node server/scripts/trialPreflight.js",
    "tune:weights": "node server/scripts/tuneMatchingWeights.js",
    "verify:baseline": "node server/scripts/verifyBaselineInvariants.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.0",
    "@radix-ui/react-alert-dialog": "^1.1.2",
    "@radix-ui/react-checkbox": "^1.1.2",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-select": "^2.1.2",
    "@radix-ui/react-slot": "^1.1.0",
    "@tanstack/react-query": "^5.59.0",
    "better-sqlite3": "^11.5.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "date-fns": "^4.1.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "fastest-levenshtein": "^1.0.16",
    "helmet": "^8.3.0",
    "lucide-react": "^0.454.0",
    "multer": "^2.2.0",
    "pdfkit": "^0.20.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.53.1",
    "react-markdown": "^9.0.1",
    "react-router-dom": "^6.27.0",
    "tailwind-merge": "^2.5.4"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.0.1",
    "jsdom": "^30.0.1",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "vite": "^5.4.9",
    "vitest": "^2.1.9"
  },
  "allowScripts": {
    "better-sqlite3@11.10.0": true,
    "esbuild@0.21.5": true,
    "fsevents@2.3.3": true
  }
}
