{
  "name": "thriv3",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,client -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node server/index.js",
    "dev:client": "vite",
    "build": "vite build",
    "seed": "node server/seed/seedFromLocalData.js",
    "coaching-import": "node server/scripts/coachingImport.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed:engagement": "node server/seed/seedEngagement.js",
    "export:profiles": "node server/scripts/exportProfiles.js",
    "rollup": "node server/scripts/rebuildRollups.js",
    "seed:activity": "node server/seed/seedEngagementActivity.js",
    "test:acceptance": "vitest run server/export/tracker.test.js server/routes/publicProfile.test.js server/routes/track.test.js server/lib/athleteLifecycle.test.js server/lib/engagementRollup.test.js",
    "build:worker": "esbuild worker/index.js --bundle --format=esm --platform=neutral --outfile=build/public/_worker.js",
    "publish": "npm run export:profiles && npm run build:worker && wrangler pages deploy build/public --project-name thriv3-profiles --branch main --commit-dirty=true",
    "sync": "node server/scripts/syncEngagement.js",
    "edge:schema": "wrangler d1 execute thriv3-engagement --remote --file worker/schema.sql",
    "simulate": "node server/seed/simulateEngagement.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.0",
    "@radix-ui/react-alert-dialog": "^1.1.2",
    "@radix-ui/react-checkbox": "^1.1.2",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-select": "^2.1.2",
    "@radix-ui/react-slot": "^1.1.0",
    "@tanstack/react-query": "^5.59.0",
    "better-sqlite3": "^11.5.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "date-fns": "^4.1.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "fastest-levenshtein": "^1.0.16",
    "lucide-react": "^0.454.0",
    "multer": "^2.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.53.1",
    "react-markdown": "^9.0.1",
    "react-router-dom": "^6.27.0",
    "tailwind-merge": "^2.5.4"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.0.1",
    "jsdom": "^30.0.1",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "vite": "^5.4.9",
    "vitest": "^2.1.9"
  },
  "allowScripts": {
    "better-sqlite3@11.10.0": true,
    "esbuild@0.21.5": true,
    "fsevents@2.3.3": true
  }
}
