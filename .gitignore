node_modules
dist
.env
.DS_Store

# Runtime-generated — both created automatically by the app at startup
# (see server/db/client.js and server/index.js). Contains local player
# data / uploaded match-recommendation files — never commit these.
# The trailing slash matches a DIRECTORY only. A symlink of the same name is
# not matched by it, which is how `server/data` and `server/uploads` were once
# committed as absolute symlinks into a developer's home directory — dangling
# on any other machine, and client.js's mkdirSync then throws ENOENT at import
# before the database is opened. Both spellings are listed so the path is
# ignored whatever it is.
server/data/
server/data
server/uploads/
server/uploads

# Generated public profile pages
build/

# esbuild output for the Pages worker
worker/dist/

# Generated client report artefacts — never commit these
server/reports/
